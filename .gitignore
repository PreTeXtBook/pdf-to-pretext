# the PreTeXt clone used for builds
/pretext/
# transcription attempts
/runs/
# fetched documents: reproduced by scripts/fetch-arxiv.sh, licenses vary
/corpus/**/*.pdf
/corpus/**/source/
/corpus/**/eprint*
/corpus/**/pages/
/corpus/**/*.txt
# the round-trip cases are written here, so their sources are kept; their builds are not
!/corpus/round-trip/*/source/
/corpus/round-trip/*/output/
/corpus/round-trip/*/assets/
# builds of the worked examples
/examples/*/output/
# where PreTeXt is on one machine (see skill/pdf-to-pretext/scripts/check-setup.sh)
/skill/pdf-to-pretext/config.local
# build and tool residue
*.log
__pycache__/
