<?xml version="1.0" encoding="UTF-8"?>
<!-- Publication file for a transcribed research article.  The numbering mimics the -->
<!-- original's levels where PreTeXt allows it; where PreTeXt's scheme is more      -->
<!-- constrained, PreTeXt wins (references/numbering.md).                            -->
<publication>
    <source>
        <!-- the directory of external files is declared in docinfo (source/main.ptx) -->
        <directories generated="../generated-assets"/>
    </source>
    <numbering>
        <!-- articles: "1" numbers within sections, "0" numbers through the whole paper -->
        <divisions level="2"/>
        <blocks level="1"/>
        <equations level="1"/>
        <figures level="1"/>
        <footnotes level="0"/>
    </numbering>
</publication>
