<?xml version="1.0" encoding="UTF-8"?>
<!-- Transcribed from: ORIGIN (identifier, version), LICENSE OF THE ORIGINAL -->
<!-- The working papers of the transcription are in ../transcription: manifest.md, notes.md -->
<pretext xml:lang="en-US" xmlns:xi="http://www.w3.org/2001/XInclude">
    <docinfo>
        <!-- Cropped figures and other files the source names go in ../assets -->
        <directories external="../assets"/>
        <!-- Only the author's macros that carry meaning, in forms MathJax accepts; -->
        <!-- see references/macros.md.  Empty when only the PDF is at hand.        -->
        <macros>
        </macros>
    </docinfo>

    <article xml:id="article-NAME">
        <title>TITLE</title>

        <frontmatter>
            <bibinfo>
                <author>
                    <personname>NAME</personname>
                    <institution>INSTITUTION</institution>
                    <email>EMAIL</email>
                </author>
                <!-- A date, keywords, and subject codes only when the document prints them -->
                <date>DATE</date>
                <keywords authority="msc" variant="2020">
                    <keyword>CODE</keyword>
                </keywords>
            </bibinfo>
            <!-- Required by the schema, between bibinfo and abstract -->
            <titlepage>
                <titlepage-items/>
            </titlepage>
            <abstract>
                <p>ABSTRACT</p>
            </abstract>
        </frontmatter>

        <!-- One file for each section of the original, in the original's order.  The  -->
        <!-- comment with a section's original number goes here, before its include: -->
        <!-- a comment before the root element of an included file is lost when the  -->
        <!-- files are assembled.  Rename the file for the section's own title.      -->

        <!-- Original: Section 1 -->
        <xi:include href="sections/section-introduction.ptx"/>

        <!-- A document with no bibliography has no backmatter: take these lines out. -->
        <backmatter>
            <!-- Original: References (unnumbered) -->
            <xi:include href="sections/references.ptx"/>
        </backmatter>
    </article>
</pretext>
